<Project Sdk="Microsoft.NET.Sdk">
  <!-- 冒险战争（mxzz）静态反推/校验工具 —— 只读，不写任何 dll -->
  <!-- Mono.Cecil 路径参数化：默认取仓库 01_tools，可用 -p:CecilPath=... 覆盖 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>advwar_static</AssemblyName>
    <RootNamespace>advwar_static</RootNamespace>
    <RestorePackages>false</RestorePackages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CecilPath Condition="'$(CecilPath)'==''">E:\nixiang\01_tools\il2cppdumper\Mono.Cecil.dll</CecilPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(CecilPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
