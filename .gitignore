# 内嵌补丁 DLL 的静态库（llvm-objcopy -I binary 产物）。命名统一为 *PatchedDll*.a，
# 新增游戏不必再改本文件。
!mod菜单/**/Games/*PatchedDll*.a
!mod菜单/**/targetfuntional_dll*.bin
mod菜单/starry-mod-menu_111/

# ===== 2026-10-03：境界守望者（构建期临时物，可再生）=====
# starry_link/：wor_build_so.sh:20-30 为规避「mod菜单/ 含中文 ⇒ ndk-build 的 make 在 Windows 下
# 打乱非 ASCII 路径」而建的纯 ASCII 目录 junction（指向 mod菜单/starry-mod-menu），构建时自动重建，
# 收尾应删（删它必须用 `cmd /c rmdir` 解链，绝不能用 `rm -rf` 跟链删真项目）。
starry_link/
# .wor_build/：wor_build_so.sh 的纯 ASCII 构建输出目录（obj/ + libs/）。2026-10-04 加。
# 理由：NDK_OUT/NDK_LIBS_OUT 既不能落在 mod菜单/（非 ASCII），也不能挂在 starry_link/ 下
# ——cygpath 会把 junction 解析回真实中文路径（实测 cygpath -w /e/nixiang/starry_link/obj_wor
# → E:\nixiang\mod菜单\starry-mod-menu\obj_wor），ndk-build 的 make 与 clang 对该路径的编码
# 处理不一致 ⇒ 一边在 mod菜单/… 建目录、另一边去 mod<乱码>/… 写 .o。故落到仓库根下纯 ASCII
# 目录，编完由脚本 cp 回填契约路径 mod菜单/starry-mod-menu/libs_wor/arm64-v8a/（可再生）。
/.wor_build/
# 顶层一次性驱动脚本（_tmp_e2build.sh / _tmp_e2chain.sh / _tmp_e2launch.sh / _tmp_deliver.sh …）。
# 正式脚本一律落 04_scripts/{游戏}/，例如 _tmp_e2launch.sh 已正式化为
# 04_scripts/境界守望者/wor_launch.sh（真机冒烟 + 双路 logcat 取证）。
_tmp_*.sh

# ===== 2026-10-04：勇士之心构建中间物与安装暂存（可再生）=====
# .ysxz_menu_dex/：ysxz_build_menu_dex.sh 的 gradle/apktool/smali 工作区（解包 smali、
#   合成 classes4.dex，约 124 MB）。产物由脚本 cp 回契约路径
#   mod菜单/starry-mod-menu/libs_ysxz/classes4.dex。
/.ysxz_menu_dex/
# .ysxz_103_build/：ysxz_build_so_103.sh 的纯 ASCII NDK 构建目录（同 .wor_build 的理由：
#   中文路径会让 Windows 下的 make/clang 分叉到 mod<乱码>/）。产物回填
#   mod菜单/starry-mod-menu/libs_ysxz/arm64-v8a/libstarry_magic.so。
/.ysxz_103_build/
# _install_stage/：装机暂存（各游戏 apktool 解包 + 待装 APK，单包 200 MB 级）。
_install_stage/

# preflight 凭证（本机运行时状态，2026-10-10 第二轮复盘 P10 硬化）
10_docs/_state/机器心跳/*.stamp

# pipeline device_ready 阶段留痕（本机运行时状态，2026-10-12 霓虹深渊2 复盘 P0-1）
04_scripts/*/.device_ready.txt

# ===== 2026-10-26：构建机 / 授权私钥（仓外 ~/.starry-keys，绝不入库）=====
# rsa2048.txt        = 星光授权票签名私钥（与客户端 sg_pubkey.h 成对）
# payload_master.txt = 载荷主密钥（与服务端 PAYLOAD_MASTER_PATH 同一份，派生 K_build）
# build_key.txt      = 构建机查后台的 BUILD_API_KEY（服务端 .env 同名项）
# 取法见 04_scripts/双机协作/fetch_starry_keys.sh（SSH 直连授权服务器，不走 git——
# 提交后即使下次提交删除，blob 仍永久留在历史里，清理要 filter-repo + 强推，属禁区）。
rsa2048.txt
payload_master.txt
build_key.txt
starry-keys/
.starry-keys/
