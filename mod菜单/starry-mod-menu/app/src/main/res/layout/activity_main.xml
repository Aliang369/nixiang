<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B3A"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星光助手"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="无需 root · 不修改游戏安装包\n按下面 ①②③ 顺序点一次即可，之后不用再进本 App"
            android:textColor="#A0A0C0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_diag_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#22234A"
            android:gravity="center"
            android:padding="12dp"
            android:text="体检中…"
            android:textColor="#FF9E7E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_request_allfiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#C4703C"
            android:text="① 开启所有文件访问权限（必开）"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_request_overlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#9B7ED8"
            android:text="② 开启悬浮窗权限（菜单球要用）"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_cdn_inject"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D5B"
            android:text="③ 一键注入并打开游戏（只需一次）"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_cdn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="注入：未做过（做完一次就永久生效）"
            android:textColor="#A0A0C0"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cb_cdn_auto_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="注入完成后自动关闭通道（不影响游戏正常下载）"
            android:textColor="#C8C8E0"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="球不见了？重新打开一次本 App 即可（或点通知栏「星光助手」）。"
            android:textColor="#7EE0A0"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#338B5CF6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="体检详情\n（没效果时点下面「复制」整段发给对方，不用日志）"
            android:textColor="#A0A0C0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_diag_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#22234A"
            android:padding="10dp"
            android:text=""
            android:textColor="#C8C8E0"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:typeface="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_diag_refresh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#3D3E6E"
                android:text="重新体检"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_diag_copy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#8B5CF6"
                android:text="复制报告"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_diag_share"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#5B4BC4"
            android:text="直接发送报告（微信/QQ 都行）"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
