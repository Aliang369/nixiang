<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1B3A"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="星光助手"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="无需 root · 不修改游戏安装包\n按下面 ①② 顺序点一次即可，之后不用再进本 App"
            android:textColor="#A0A0C0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_request_overlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#9B7ED8"
            android:text="① 开启悬浮窗权限（菜单球要用）"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_cdn_inject"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2E7D5B"
            android:text="② 一键注入并打开游戏（只需一次）"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_cdn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="注入：未做过（做完一次就永久生效）"
            android:textColor="#A0A0C0"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cb_cdn_auto_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="注入完成后自动关闭通道（不影响游戏正常下载）"
            android:textColor="#C8C8E0"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="球不见了？重新打开一次本 App 即可（或点通知栏「星光助手」）。"
            android:textColor="#7EE0A0"
            android:textSize="13sp" />


    </LinearLayout>
</FrameLayout>
