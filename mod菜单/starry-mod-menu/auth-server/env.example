# 复制为 .env 后按需修改（本文件不带点，方便在 Finder/宝塔里看到）
# 用法：cp env.example .env
APP_NAME=星光魔法验证
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DATABASE_URL=postgresql+psycopg2://starlight:starlight@db:5432/starlight
# 本地无 Docker 时可改用：
# DATABASE_URL=sqlite:///./starlight.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 客户端授权短票密钥（须与 APK native 默认一致；改这里必须同步改 so 重打包）
GRANT_HMAC_SECRET=sg-grant-v1-7f3a9c2e
CORS_ORIGINS=*
DEFAULT_GAME_ID=starry_self
DEFAULT_GAME_NAME=星光自测App
# 管理端 IP 白名单（逗号分隔）。空=不限制。示例：
# ADMIN_ALLOW_IPS=1.2.3.4,5.6.7.8
ADMIN_ALLOW_IPS=
ADMIN_LOGIN_MAX_FAILS=5
ADMIN_LOGIN_WINDOW_SECONDS=900
# 玩家卡密登录失败限流（按 IP）
CARD_LOGIN_MAX_FAILS=12
CARD_LOGIN_WINDOW_SECONDS=600
OFFLINE_CACHE_SECONDS=86400
